<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsAotCompatible>true</IsAotCompatible>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="GitBench.Pty.Tests" />
    </ItemGroup>

    <!--
        Windows sessions run on the ConPTY that Microsoft publishes with Windows Terminal rather
        than the one inside kernel32. The inbox host re-serialises a program's output on its own
        renderer thread and leaks mid-frame cursor positions past the program's synchronized-update
        frames, which shows as the caret jumping every frame under TUIs such as Codex. The published
        host passes the program's bytes through as written.

        conpty.dll is only a launcher: it spawns the OpenConsole.exe it finds beside itself, or in an
        architecture-named folder beside itself, and quietly falls back to the inbox conhost when it
        finds neither. Both are copied by hand rather than through the package's own targets, which
        copy nothing for a build without a RuntimeIdentifier, so that a dev build and a test run host
        the same console as a published one. The arm64 host ships with the x64 one because an x64
        build runs on ARM64 Windows and the launcher picks the native host there.
    -->
    <PropertyGroup>
        <!-- A Windows target, or an untargeted build on a Windows machine. Never a cross-compile
             for another platform, whatever machine it runs on. -->
        <ShipConPty Condition="'$(ShipConPty)' == '' And $(RuntimeIdentifier.StartsWith('win'))">true</ShipConPty>
        <ShipConPty Condition="'$(ShipConPty)' == '' And '$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">true</ShipConPty>
        <ConPtyArch Condition="$(RuntimeIdentifier.Contains('arm64'))">arm64</ConPtyArch>
        <ConPtyArch Condition="'$(ConPtyArch)' == '' And '$(RuntimeIdentifier)' == '' And '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'Arm64'">arm64</ConPtyArch>
        <ConPtyArch Condition="'$(ConPtyArch)' == ''">x64</ConPtyArch>
    </PropertyGroup>

    <ItemGroup Condition="'$(ShipConPty)' == 'true'">
        <PackageReference Include="Microsoft.Windows.Console.ConPTY" Version="1.24.260710001"
                          GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup Condition="'$(ShipConPty)' == 'true' And '$(PkgMicrosoft_Windows_Console_ConPTY)' != ''">
        <None Include="$(PkgMicrosoft_Windows_Console_ConPTY)\runtimes\win-$(ConPtyArch)\native\conpty.dll"
              Link="conpty.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
        <None Include="$(PkgMicrosoft_Windows_Console_ConPTY)\build\native\runtimes\arm64\OpenConsole.exe"
              Link="arm64\OpenConsole.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
        <None Condition="'$(ConPtyArch)' == 'x64'"
              Include="$(PkgMicrosoft_Windows_Console_ConPTY)\build\native\runtimes\x64\OpenConsole.exe"
              Link="x64\OpenConsole.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    </ItemGroup>

</Project>
