<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <!-- The project under test is AOT-published, but the test host runs on the CLR; don't
             inherit AOT/trim settings here. -->
        <PublishAot>false</PublishAot>
        <!-- xUnit runs one collection per core, and many of these tests park a pool thread on
             purpose to hold a gate open. The pool's default floor is ProcessorCount and it grows
             past that by hill-climbing at about a thread per second, so a Task.Run issued while
             those threads are parked can sit queued for seconds — long enough to blow the deadline
             of whichever unrelated test happens to be waiting on it. The floor is sized here for
             the concurrency the suite actually creates. -->
        <ThreadPoolMinThreads>256</ThreadPoolMinThreads>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
        <PackageReference Include="xunit" Version="2.9.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\GitBench\GitBench.csproj" />
        <ProjectReference Include="..\framework\ZGF.Gui.Testing\ZGF.Gui.Testing.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!--
            NStack.Core arrives transitively with the vendored engine and declares its own
            System.Rune, ambiguous with System.Text.Rune wherever the bare name is used. Same alias,
            and for the same reason, as GitBench.Terminal.Vt.XtermSharp.
        -->
        <Using Include="System.Text.Rune" Alias="Rune" />
    </ItemGroup>

</Project>
