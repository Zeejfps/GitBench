; Injected languages, vendored from the grammar's own repository.
;
; Generated by scripts/vendor-highlight-queries.py -- edit that, not this.
;
; @injection.content is the region, and its language is either named by an @injection.language
; capture (a fenced block's info string) or set outright by the pattern. A language we bundle no
; grammar for leaves its region uncolored, which is why the ones naming latex and toml are kept.
;
; Two patterns naming the same region resolve to the later one, so a specific rule (a <script>
; whose lang attribute says TypeScript) is written after the general one it refines.
;
; Source:
;   tree-sitter-html/queries/injections.scm @ 5a5ca85
;   tree-sitter-svelte/queries/injections.scm @ 774a65a

((script_element
  (raw_text) @injection.content)
 (#set! injection.language "javascript"))

((style_element
  (raw_text) @injection.content)
 (#set! injection.language "css"))

((style_element
  (start_tag
    (attribute
      (attribute_name) @_attr
      (quoted_attribute_value
        (attribute_value) @_lang)))
  (raw_text) @injection.content)
  (#eq? @_attr "lang")
  (#any-of? @_lang "scss" "postcss" "less")
  (#set! injection.language "scss"))

; LOCAL: upstream hands every raw_text to JavaScript, a <style> body included, and leaves
; LOCAL: the host it inherits html_tags from to sort that out. The html rules above already
; LOCAL: send a <script> body to JavaScript and a <style> body to CSS, so the catch-all is
; LOCAL: dropped; the lang="ts" rule below still overrides the script one, being later.

((script_element
  (start_tag
    (attribute
      (attribute_name) @_attr
      (quoted_attribute_value
        (attribute_value) @_lang)))
  (raw_text) @injection.content)
  (#eq? @_attr "lang")
  (#any-of? @_lang "ts" "typescript")
  (#set! injection.language "typescript"))

((element
  (start_tag
    (attribute
      (attribute_name) @_attr
      (quoted_attribute_value
        (attribute_value) @injection.language)))
  (text) @injection.content)
  (#eq? @_attr "lang")
  (#eq? @injection.language "pug"))

; LOCAL: upstream leaves template expressions -- `{count * 2}`, an {#if} condition, the
; LOCAL: list an {#each} walks -- uncolored; nvim-treesitter's own svelte queries inject
; LOCAL: them, and this is that rule.
((svelte_raw_text) @injection.content
  (#set! injection.language "javascript"))
