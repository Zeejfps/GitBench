{
  "name": "Ctx",
  "scopeName": "source.ctx",
  "fileTypes": ["ctx"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#builtins" },
    { "include": "#attributes" },
    { "include": "#enum-declaration" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#primitive-types" },
    { "include": "#variant-paths" },
    { "include": "#namespace-paths" },
    { "include": "#types" },
    { "include": "#match-arms" },
    { "include": "#calls" },
    { "include": "#named-arguments" },
    { "include": "#labels" },
    { "include": "#bind-placeholder" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ctx",
          "begin": "//",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.ctx" } },
          "end": "$"
        },
        {
          "name": "comment.block.ctx",
          "begin": "/\\*",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.ctx" } },
          "end": "\\*/",
          "endCaptures": { "0": { "name": "punctuation.definition.comment.end.ctx" } }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ctx",
          "begin": "\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.ctx" } },
          "end": "\"",
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.ctx" } },
          "patterns": [ { "include": "#escapes" } ]
        },
        {
          "name": "string.quoted.single.ctx",
          "match": "(')(?:(\\\\(?:x[0-9A-Fa-f]{2}|[ntr0\\\\\"']))|[^'\\\\])(')",
          "captures": {
            "1": { "name": "punctuation.definition.string.begin.ctx" },
            "2": { "name": "constant.character.escape.ctx" },
            "3": { "name": "punctuation.definition.string.end.ctx" }
          }
        }
      ]
    },
    "escapes": {
      "patterns": [
        { "name": "constant.character.escape.ctx", "match": "\\\\(?:x[0-9A-Fa-f]{2}|[ntr0\\\\\"'])" },
        { "name": "invalid.illegal.escape.ctx", "match": "\\\\." }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.ctx",
          "match": "\\b(?:0[xX][0-9A-Fa-f_]+|0[bB][01_]+|[0-9][0-9_]*(?:\\.[0-9][0-9_]*)?(?:[eE][+-]?[0-9]+)?)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.ctx",
          "match": "@[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "match": "(#)((?:[A-Za-z_][A-Za-z0-9_]*\\s*::\\s*)*)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.definition.decorator.ctx" },
            "2": { "patterns": [ { "include": "#namespace-paths" } ] },
            "3": { "name": "entity.name.function.decorator.ctx" }
          }
        }
      ]
    },
    "enum-declaration": {
      "begin": "\\b(enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "beginCaptures": {
        "1": { "name": "storage.type.ctx" },
        "2": { "name": "entity.name.type.ctx" }
      },
      "end": "\\}",
      "endCaptures": { "0": { "name": "punctuation.bracket.ctx" } },
      "patterns": [
        { "include": "#comments" },
        { "include": "#numbers" },
        { "include": "#builtins" },
        { "include": "#constants" },
        { "include": "#primitive-types" },
        { "include": "#variant-paths" },
        { "include": "#namespace-paths" },
        { "include": "#types" },
        {
          "match": "(?:^|(?<=[{,]))\\s*([a-z_][A-Za-z0-9_]*)\\b",
          "captures": { "1": { "name": "constant.other.enum-member.ctx" } }
        },
        { "include": "#operators" },
        { "include": "#punctuation" }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.ctx" },
            "2": { "name": "entity.name.function.ctx" }
          }
        },
        {
          "match": "\\b(struct|union|enum|type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.ctx" },
            "2": { "name": "entity.name.type.ctx" }
          }
        },
        {
          "match": "\\b(capability)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.ctx" },
            "2": { "name": "entity.name.type.ctx" }
          }
        },
        {
          "match": "\\b(namespace)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.namespace.ctx" },
            "2": { "name": "entity.name.namespace.ctx" }
          }
        },
        {
          "match": "\\b(const)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.ctx" },
            "2": { "name": "constant.other.ctx" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.ctx", "match": "\\b(?:if|else|while|match|return|break|continue|defer)\\b" },
        { "name": "keyword.other.logical.ctx", "match": "\\b(?:and|or|not)\\b" },
        { "name": "storage.type.ctx", "match": "\\b(?:fn|struct|union|enum|type|namespace|let|const|capability)\\b" },
        { "name": "storage.modifier.ctx", "match": "\\b(?:mut|extern)\\b" }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.ctx", "match": "\\b(?:null|some|true|false)\\b" },
        { "name": "constant.other.ctx", "match": "\\b[A-Z][A-Z0-9]*_[A-Z0-9_]*\\b" }
      ]
    },
    "primitive-types": {
      "patterns": [
        { "name": "support.type.primitive.ctx", "match": "\\b(?:[iu](?:8|16|32|64)|usize|f(?:32|64)|bool)\\b" }
      ]
    },
    "variant-paths": {
      "patterns": [
        {
          "match": "\\b([A-Z][A-Za-z0-9_]*)\\s*(::)\\s*([a-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "entity.name.type.ctx" },
            "2": { "name": "punctuation.separator.namespace.ctx" },
            "3": { "name": "constant.other.enum-member.ctx" }
          }
        }
      ]
    },
    "namespace-paths": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(::)",
          "captures": {
            "1": { "name": "entity.name.namespace.ctx" },
            "2": { "name": "punctuation.separator.namespace.ctx" }
          }
        }
      ]
    },
    "types": {
      "patterns": [
        { "name": "entity.name.type.ctx", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" }
      ]
    },
    "match-arms": {
      "patterns": [
        {
          "match": "\\b([a-z_][A-Za-z0-9_]*)(?=\\s*(?:\\{[^{}]*\\})?\\s*=>)",
          "captures": { "1": { "name": "constant.other.enum-member.ctx" } }
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "match": "\\b([a-z_][A-Za-z0-9_]*)(?=\\{|\\s*\\()",
          "captures": { "1": { "name": "entity.name.function.call.ctx" } }
        }
      ]
    },
    "named-arguments": {
      "patterns": [
        {
          "match": "([{,])\\s*([a-z_][A-Za-z0-9_]*)\\s*(?==(?![=>]))",
          "captures": {
            "1": { "name": "punctuation.bracket.ctx" },
            "2": { "name": "variable.parameter.ctx" }
          }
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=:(?!:))",
          "captures": { "1": { "name": "variable.parameter.ctx" } }
        }
      ]
    },
    "bind-placeholder": {
      "patterns": [
        { "name": "keyword.other.bind.ctx", "match": "\\b_\\b" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.ctx", "match": "=>|->|\\.\\*|\\.\\.|<<|>>|==|!=|<=|>=|[-+*/%<>=&|^?]" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.separator.ctx", "match": "[,.:;]" },
        { "name": "punctuation.bracket.ctx", "match": "[{}()\\[\\]]" }
      ]
    }
  }
}
