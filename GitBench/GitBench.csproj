<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- AOT only for published releases (CI publishes -c Release). In Debug, PublishAot would
             bake MetadataUpdater/StartupHook=false into runtimeconfig.json and disable Hot Reload
             without actually AOT-compiling, so keep it off there. -->
        <PublishAot Condition="'$(Configuration)' == 'Release'">true</PublishAot>
        <IsAotCompatible>true</IsAotCompatible>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ApplicationIcon>Assets\app_icon.ico</ApplicationIcon>
        <!-- The shipped executable name, and so the mainExe vpk is given in release.yml. Set
             explicitly because it no longer follows the project name; the namespace deliberately
             does not follow it either. -->
        <AssemblyName>DiffDino</AssemblyName>
        <!-- Default for local/dev builds. CI overrides with a -p:Version=<tag> publish arg
             (see release.yml) so the version shown in-app matches the release tag. -->
        <Version>0.0.0-dev</Version>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Velopack" Version="1.1.1" />
        <!-- TextMate-grammar tokenizer for diff syntax highlighting (MIT). Ships a per-RID
             Oniguruma native (libonigwrap) as a runtime asset; verified NativeAOT-clean. -->
        <PackageReference Include="TextMateSharp" Version="2.0.3" />
        <PackageReference Include="TextMateSharp.Grammars" Version="2.0.3" />
    </ItemGroup>

    <ItemGroup>
        <!-- The diff syntax-highlighting logic modules are internal; the test project drives
             them directly. The automation runner builds the app through GitBenchHost. -->
        <InternalsVisibleTo Include="GitBench.Tests" />
        <InternalsVisibleTo Include="GitBench.Automation" />
    </ItemGroup>

    <ItemGroup>
        <None Update="Assets\app_icon.rgba">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <!-- Shown in-app (About dialog, welcome screen), loaded via GuiApp.LoadImage. -->
        <None Update="Assets\app_icon.png">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="Assets\app_icon_mac.png">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <!-- Small dino mark for assistant surfaces, loaded via GuiApp.LoadImage. -->
        <None Update="Assets\assistant_mark.png">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <!-- Fonts are embedded into the assembly instead of shipped as loose files. -->
    <ItemGroup>
        <None Remove="Assets\Fonts\**\*.ttf" />
        <EmbeddedResource Include="Assets\Fonts\**\*.ttf">
            <LogicalName>%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

    <!-- TextMate grammars for languages TextMateSharp.Grammars doesn't bundle (Svelte). Embedded
         and loaded by BundledGrammarRegistryOptions; the LogicalName is the lookup key. -->
    <ItemGroup>
        <None Remove="Assets\Grammars\**\*.json" />
        <EmbeddedResource Include="Assets\Grammars\**\*.json">
            <LogicalName>%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

    <!-- Assistant agent prompts. AgentCatalog enumerates every embedded .md by LogicalName, so
         adding an agent is adding a file here — no registration step. -->
    <ItemGroup>
        <None Remove="Features\Assistant\Agents\**\*.md" />
        <EmbeddedResource Include="Features\Assistant\Agents\**\*.md">
            <LogicalName>%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\framework\ZGF.AppUtils\ZGF.AppUtils.csproj" />
        <!-- The terminal: the pseudo-terminal, the engine seam, and the XtermSharp adapter behind
             it. Only AppServices names the adapter, so replacing the engine touches one line. -->
        <ProjectReference Include="..\GitBench.Pty\GitBench.Pty.csproj" />
        <ProjectReference Include="..\GitBench.Terminal.Vt\GitBench.Terminal.Vt.csproj" />
        <ProjectReference Include="..\GitBench.Terminal.Vt.XtermSharp\GitBench.Terminal.Vt.XtermSharp.csproj" />
        <!-- Image codecs behind the diff view's image preview. PngSharp also arrives
             transitively through ZGF.Gui; referenced explicitly because the app decodes with it
             directly. -->
        <ProjectReference Include="..\framework\PngSharp\PngSharp\PngSharp.csproj" />
        <ProjectReference Include="..\framework\JpegSharp\JpegSharp.csproj" />
        <ProjectReference Include="..\framework\ZGF.Gui\ZGF.Gui.csproj" />
        <ProjectReference Include="..\framework\ZGF.Gui.Desktop\ZGF.Gui.Desktop.csproj" />
        <ProjectReference Include="..\framework\ZGF.Gui.Generator\ZGF.Gui.Generator.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <!-- The language-server client: protocol, configuration and document bookkeeping. It
             references nothing itself, so the dependency runs one way only — the app knows about
             LSP, and LSP knows nothing about the app. -->
        <ProjectReference Include="..\GitBench.Lsp\GitBench.Lsp.csproj" />
        <ProjectReference Include="..\external\cs_tree_sitter\TreeSitter\TreeSitter.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="Assets\Queries\**\*.scm" />
        <!-- Outline queries (the @def./@name capture protocol), one per bundled grammar. -->
        <EmbeddedResource Include="Assets\Queries\*.scm">
            <LogicalName>%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>
        <!-- Highlight queries, vendored from each grammar's own repository. A separate logical
             prefix because both sets name their files after the grammar. -->
        <EmbeddedResource Include="Assets\Queries\Highlights\*.scm">
            <LogicalName>highlights.%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>
        <!-- Injection queries: which regions of a file are written in another language. Only the
             few grammars that embed one ship a file here. -->
        <EmbeddedResource Include="Assets\Queries\Injections\*.scm">
            <LogicalName>injections.%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

    <Import Project="..\external\cs_tree_sitter\native\Native.props" />

    <ItemGroup>
        <DirectPInvoke Include="tree-sitter" />
        <NativeLibrary Include="$(NativeArtifactsDir)$(StaticLibraryPrefix)tree-sitter$(StaticLibraryExtension)" />
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="Localization\Strings\*.json" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\docs\Screenshot.jpg">
        <Link>docs\Screenshot.jpg</Link>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="..\docs\plans\">
        <Link>docs\plans</Link>
      </Folder>
    </ItemGroup>

    <!-- macOS .app bundling is handled by `vpk pack` in the release workflow (it builds the
         bundle with the Velopack update structure embedded), so there's no MSBuild target here. -->

    <ItemGroup>
        <!--
            NStack.Core arrives transitively with the vendored engine and declares its own
            System.Rune, ambiguous with System.Text.Rune wherever the bare name is used. Same alias,
            and for the same reason, as GitBench.Terminal.Vt.XtermSharp.
        -->
        <Using Include="System.Text.Rune" Alias="Rune" />
    </ItemGroup>

</Project>
